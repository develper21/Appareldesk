# ==============================================
# ApparelDesk Frontend - Environment Reference
# ------------------------------------------------
# TEMPLATE ONLY — actual values live in:
#   dev        ->  .env.local
#   production ->  .env.production  (and/or Netlify UI env vars)
# Copy to `.env.local` and adjust for your machine.
# ==============================================

# Base URL of the NestJS API (no trailing slash).
# Leave EMPTY in development to use the Vite proxy (/api -> http://localhost:3001).
# In production, point it at the Render deployment:
#   https://appareldesk-api.onrender.com/api
VITE_API_URL=http://localhost:3001/api

# How long (ms) to wait before an API call times out
VITE_API_TIMEOUT=15000
