# ==============================================
# ApparelDesk API - Environment Configuration
# Copy this file to `.env` and fill in the values
# ==============================================

# ---------- App ----------
NODE_ENV=development
PORT=3001
API_PREFIX=api

# CORS: comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:8080,http://localhost:3000

# ---------- MongoDB ----------
# Local:    mongodb://localhost:27017
# Atlas:    mongodb+srv://<user>:<password>@<cluster>.mongodb.net
# NOTE: use a unique DB name to avoid clashing with other projects sharing the server
MONGODB_URI=mongodb://localhost:27017/appareldesk

# ---------- JWT ----------
# Secret used to sign access tokens (change in production!)
JWT_SECRET=change-me-to-a-long-random-secret-string
JWT_EXPIRES_IN=7d

# Seed admin credentials (used by `npm run seed`)
ADMIN_EMAIL=admin@appareldesk.com
ADMIN_PASSWORD=admin123
