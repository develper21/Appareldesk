# ==============================================
# ApparelDesk API - Environment Reference
# ------------------------------------------------
# TEMPLATE ONLY — actual values live in:
#   dev        ->  server/.env.local
#   production ->  server/.env.production
# Copy to `server/.env.local` and adjust for your machine.
#
# On Render, set these as Environment Variables in the
# dashboard instead (render.yaml wires them automatically).
# ==============================================

# ---------- App ----------
NODE_ENV=development
PORT=3001
API_PREFIX=api

# CORS: comma-separated list of allowed frontend origins
# dev:      http://localhost:8080,http://localhost:3000
# prod:     https://your-site.netlify.app
CORS_ORIGINS=http://localhost:8080,http://localhost:3000

# ---------- MongoDB ----------
# Local:    mongodb://localhost:27017/appareldesk
# Atlas:    mongodb+srv://<user>:<password>@<cluster>.mongodb.net/appareldesk
# NOTE: always include the database name (/appareldesk) in the URI
MONGODB_URI=mongodb://localhost:27017/appareldesk

# ---------- JWT ----------
# Secret used to sign access tokens (change in production!)
JWT_SECRET=change-me-to-a-long-random-secret-string
JWT_EXPIRES_IN=7d

# Seed admin credentials (used by `npm run seed`)
ADMIN_EMAIL=admin@appareldesk.com
ADMIN_PASSWORD=admin123
